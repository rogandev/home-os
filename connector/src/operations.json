              "type": "string",
              "maxLength": 4000
            },
            "locationId": {
              "type": "string",
              "maxLength": 4000
            },
            "quantity": {
              "type": "integer",
              "minimum": 0
            },
            "reorder_at": {
              "type": "integer",
              "minimum": 0
            },
            "replenishmentPolicy": {
              "type": "string",
              "enum": [
                "manual",
                "auto_replenish",
                "do_not_order"
